{
  "dsh": {
    "baseUrl": "http://127.0.0.1:2852",
    "sessionCwd": "C:\\path\\to\\your\\QQChat-workspace",
    "workspaceTitle": "QQ 聊天",
    "agentPreset": "qq-chat",
    "provider": "trae",
    "model": "deepseek-v4.1-flash",
    "reasoningEffort": "high",
    "archiveStaleSessions": true
  },
  "onebot": {
    "wsUrl": "ws://127.0.0.1:3001",
    "accessToken": "CHANGE_ME_随机令牌"
  },
  "allow": {
    "private": [],
    "groups": [],
    "admins": [],
    "deny": { "private": [], "groups": [] },
    "allowAllWhenEmpty": false
  },
  "replyTimeoutMs": 20000,
  "maxContextTurns": 30,
  "contextClearStrategy": "compact",
  "sendDelayMs": 400,
  "chunkSize": 1000,
  "bubbleMaxChars": 30,
  "mergeMaxChars": 15,
  "sendIntervalMs": 500,
  "typingDelay": {
    "enabled": true
  },
  "trimEndPunctuation": {
    "enabled": true,
    "keep": ["？", "！"]
  },
  "groupAtReply": true,
  "groupAtPosition": "last",
  "personaBotName": "",
  "personaGroupName": "",
  "personaParticipation": "normal",
  "personaText": "",
  "personaExtraRules": "",
  "personaSystemPrompt": "",
  "rhythm": {
    "activityLevel": 1,
    "debounceWindowMs": 800,
    "batchIntervalMs": 2500,
    "rateLimit": { "perMin": 12, "burst": 3, "silent": true },
    "mute": { "enabled": true, "words": ["闭嘴", "安静", "别刷屏"], "seconds": 60 }
  },
  "stateFile": "./state/sessions.json"
}
