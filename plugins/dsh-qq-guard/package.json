{
  "name": "@local/dsh-qq-guard",
  "version": "1.2.0",
  "private": true,
  "description": "QQ 聊天会话的安全硬边界，以及 QQ 桥接的运行时参数设置页（分片节奏 / 群聊 @ / 标点处理）。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "usage-stats.mjs",
    "napcat.mjs",
    "bridge-runner.mjs",
    "model-override.js",
    "holidays.json",
    "sandbox/*.mjs",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
